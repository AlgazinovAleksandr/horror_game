# Godot
.godot/
*.import
export_presets.cfg
*.uid

# Blender
*.blend1
*.blend2

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Secrets — all .env variants (.env.local, .env.backup, ...) except the template
.env*
!.env.example

# Godot export / build artifacts (export_presets.cfg above can hold signing credentials)
build/
export/
*.app
*.dmg
*.pck

# Claude Code local settings (personal permissions, not for the shared repo)
.claude/settings.local.json

# Logs
*.log

# Draft textures (local working copies — .gitkeep preserves folder structure)
game/assets/textures/*/draft/*.png
game/assets/textures/*/draft/*.jpg
game/assets/textures/*/draft/*.jpeg

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
