# Copy this file to .env and fill in your keys. Never commit .env.

# Cloudflare Workers AI — THE LIVE IMAGE PIPELINE (flux-1-schnell), used by the
# level-3-image-generator in the skill pack at ~/Downloads/claude-image-generation-main.
# Its generate.py walks up from the working directory and loads THIS repo's .env, so both
# values belong here rather than in the pack's own .env. See CLAUDE.md -> Image Generation.
# Account ID: Cloudflare dashboard -> Workers & Pages (also the hex id in the dashboard URL)
# API token:  https://dash.cloudflare.com/profile/api-tokens — needs Workers AI read access
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ⚠️ Google Gemini — DEAD since 2026-08-15. It powered nano-banana-pro/, whose API path no
# longer works; the directory is kept only so old .md references resolve. Nothing calls this
# key any more — use the Cloudflare pair above for image generation.
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — used for story/narrative/dialogue generation
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

MODEL_NAME='nvidia/nemotron-3-super-120b-a12b:free'
BASE_URL='https://openrouter.ai/api/v1'

# Hugging Face — used for free AI models (TripoSR 3D gen, MusicGen audio gen)
# Get token at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=
